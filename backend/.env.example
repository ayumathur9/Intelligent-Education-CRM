# =============================================================================
# Intelligent Education CRM — Environment Variables Template
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env to git. Use Railway environment variables for production.
# =============================================================================

# ---------------------------------------------------------------------------
# Django Core
# ---------------------------------------------------------------------------
DJANGO_ENV=development
DJANGO_DEBUG=1
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-50-char-random-secret

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# CORS (comma-separated origins — must include your frontend origin)
# ---------------------------------------------------------------------------
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# ---------------------------------------------------------------------------
# CSRF (comma-separated trusted origins — must match your production domain)
# Production example: https://your-project.railway.app
# ---------------------------------------------------------------------------
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ---------------------------------------------------------------------------
# Database
# Railway injects DATABASE_URL automatically via the PostgreSQL plugin.
# For local dev with Docker Compose, use the value below.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/intelligent_education_crm

# ---------------------------------------------------------------------------
# Redis (required for WebSocket production deployment)
# Railway injects REDIS_URL automatically via the Redis plugin.
# ---------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
SESSION_COOKIE_AGE_SECONDS=28800

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# ---------------------------------------------------------------------------
# Email (Gmail SMTP)
# Create a Gmail App Password at: myaccount.google.com/apppasswords
# ---------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password-here
DEFAULT_FROM_EMAIL=Intelligent Education CRM <your-email@gmail.com>
FRONTEND_BASE_URL=http://localhost:5500

# ---------------------------------------------------------------------------
# Supabase (Storage for file uploads)
# Get these from: app.supabase.com → Project Settings → API
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=crm-uploads
SUPABASE_PUBLIC_URL_BASE=https://your-project.supabase.co/storage/v1/object/public

# ---------------------------------------------------------------------------
# Rate limiting (DRF throttling overrides)
# ---------------------------------------------------------------------------
DRF_ANON_RATE=60/min
DRF_USER_RATE=600/min
DRF_LOGIN_RATE=5/min
DRF_PASSWORD_RESET_RATE=3/min

# ---------------------------------------------------------------------------
# File uploads
# ---------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10

# ---------------------------------------------------------------------------
# Security (production only — Railway sets these automatically via HTTPS)
# ---------------------------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000

# ---------------------------------------------------------------------------
# PII Encryption (HIGH-005) — REQUIRED in production
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ---------------------------------------------------------------------------
# FIELD_ENCRYPTION_KEY=replace-me-with-fernet-key

# ---------------------------------------------------------------------------
# VirusTotal API (HIGH-008 — optional)
# Get a free API key at: virustotal.com
# ---------------------------------------------------------------------------
# VIRUSTOTAL_API_KEY=your-virustotal-api-key

# ---------------------------------------------------------------------------
# MFA Issuer (LOW-009 — optional, shown in authenticator apps)
# ---------------------------------------------------------------------------
# MFA_ISSUER=Intelligent Education CRM

# ---------------------------------------------------------------------------
# Sentry (LOW-011 — optional, enables error tracking)
# ---------------------------------------------------------------------------
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# Cache TTLs (INFRA-003 — optional overrides, seconds)
# ---------------------------------------------------------------------------
# CACHE_TTL_DASHBOARD=120
# CACHE_TTL_STUDENT_LIST=60
# CACHE_TTL_SCHOOL_LIST=300

# ---------------------------------------------------------------------------
# Superuser bootstrap (one-time — remove from env after first deploy)
# ---------------------------------------------------------------------------
# DJANGO_SUPERUSER_EMAIL=admin@yourdomain.com
# DJANGO_SUPERUSER_PASSWORD=change-me-immediately
