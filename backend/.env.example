DJANGO_ENV=development
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-me-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (comma-separated origins)
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# Database (Railway/Render usually provide DATABASE_URL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/intelligent_education_crm

# JWT
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL="Intelligent Education CRM <your-email@gmail.com>"
FRONTEND_BASE_URL=http://localhost:5500

# Supabase (Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=crm-uploads
SUPABASE_PUBLIC_URL_BASE=https://your-project.supabase.co/storage/v1/object/public

# Rate limiting (DRF throttling)
DRF_ANON_RATE=60/min
DRF_USER_RATE=600/min
