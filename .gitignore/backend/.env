DJANGO_ENV=development
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-unsafe-secret-key-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Your PostgreSQL connection string:
DATABASE_URL=postgresql://user:password@host:5432/dbname

JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

FRONTEND_BASE_URL=http://localhost:5500

# PII Encryption key — REQUIRED in production.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FIELD_ENCRYPTION_KEY=<your-key-here>

# Email (Gmail SMTP — App Password)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=your@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=Intelligent Education <no-reply@example.com>
